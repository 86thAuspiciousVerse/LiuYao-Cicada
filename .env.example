# 服务端 AI 代理配置示例。复制为 .env 后填写真实密钥，.env 不要提交。

# HTTP 服务端口
PORT=8787

# 默认提供商，可选 openai 或 claude
AI_PROVIDER=openai

# OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

# 可选调用参数（Claude 使用；OpenAI 兼容接口默认不发送 max_tokens）
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.45
